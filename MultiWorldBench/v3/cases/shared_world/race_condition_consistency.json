{
  "schema_version": "mwb.v3.case_set.v1",
  "benchmark_version": "3",
  "metric_id": "race_condition_consistency",
  "name": "竞态条件一致性",
  "description": "A、B 在同一帧向同一位置各放置一次不同方块，比较生成双视角中最终方块数量、类型的一致性，并判断最终方块是否属于本例 A/B 指定的候选材质。",
  "gt_collected": false,
  "evaluation_uses_gt": false,
  "check_frames": [
    60,
    80,
    100
  ],
  "vlm_questions": [
    {
      "id": "same_block_count",
      "text": "A、B 看到的目标位置方块数量是否一致？",
      "output": [
        0,
        1
      ]
    },
    {
      "id": "same_block_type",
      "text": "A、B 看到的目标位置方块类型是否一致？",
      "output": [
        0,
        1
      ]
    },
    {
      "id": "matches_intended_block",
      "text": "最终目标位置的方块是否与 A 或 B 本例指定的候选方块之一相同？",
      "output": [
        0,
        1
      ]
    }
  ],
  "frame_aggregation": "three-frame majority per question",
  "case_aggregation": "minimum of the three binary questions",
  "case_count": 6,
  "ranking_ready": false,
